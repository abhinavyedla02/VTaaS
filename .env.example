# VTaaS Environment Variables
# Copy this file to .env and customize for your environment.
# docker-compose.yml references these values for the API service.

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://vtaas:vtaas@db:5432/vtaas

# ─── AWS / LocalStack ──────────────────────────────────────────
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
# LocalStack dummy credentials — replace with real IAM credentials in production
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── Upload Limits (API) ───────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=524288000       # 500 MB
UPLOAD_EXPIRY_SECONDS=900             # 15 minutes

# ─── Limits (Worker) ───────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=60         # Maximum allowed video length


# ─── S3 Buckets ────────────────────────────────────────────────
# Local dev: matches LocalStack bucket names. Production: include account ID suffix.
S3_INPUT_BUCKET=vtaas-inputs
S3_OUTPUT_BUCKET=vtaas-outputs

# ─── SQS ───────────────────────────────────────────────────────
# API creates queues on startup. Worker reads these but does not create queues.
SQS_QUEUE_NAME=transcode-jobs
SQS_DLQ_NAME=transcode-jobs-dlq
SQS_MAX_RECEIVE_COUNT=3

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins for API CORS and S3 bucket CORS.
# Use * for local dev. In production, set to your Vercel domain (e.g., https://vtaas.example.com).
CORS_ALLOWED_ORIGINS=*

# ─── Feature Flags ─────────────────────────────────────────────
ENQUEUE_ENABLED=true                  # Set to "false" to skip SQS dispatch after job creation

# ─── Dev / Debug ───────────────────────────────────────────────
DEV_USER_ID=local_dev_user            # Override default user ID (falls back to "LocalDevUser")
REQUEST_LOGGING_ENABLED=true

# ─── Frontend (Vite) ──────────────────────────────────────────
# Defaults to /sample-video (Vite proxy). Set to a full URL for production (e.g., CloudFront).
# VITE_SAMPLE_VIDEO_URL=https://cdn.example.com/sample.mp4

# Browser-reachable S3 endpoint for rewriting presigned URLs.
# In local dev: http://localhost:4566. In production: unset (real AWS URLs are already reachable).
VITE_S3_ENDPOINT=http://localhost:4566


